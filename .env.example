# Alchemy API key. Used to build default RPC URLs for every chain:
#   https://<slug>.g.alchemy.com/v2/<key>
ALCHEMY_API_KEY=

# Optional per-chain overrides (full RPC URL). These win over the key above.
SOLANA_RPC_URL=
ROBINHOOD_RPC_URL=
BASE_RPC_URL=
BNB_RPC_URL=

# Server bind
PORT=3000
HOST=127.0.0.1
